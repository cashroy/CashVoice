<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>CashVoice</AssemblyName>
    <RootNamespace>CashVoice</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.2.5</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Framework-dependent: the installer adds the .NET 8 Desktop Runtime if missing. Runs on newer runtimes too. -->
    <RollForward>Major</RollForward>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <!-- Inter (SIL Open Font License, see Fonts/Inter-LICENSE.txt): same typeface as cashroy.github.io -->
    <Resource Include="Fonts\*.ttf" />
    <None Include="Fonts\Inter-LICENSE.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Win32.Registry.AccessControl" Version="8.0.0" />
  </ItemGroup>
</Project>
