<Window x:Class="CashVoice.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CashVoice.Controls"
        Title="CashVoice" Width="1000" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop"
        Background="{StaticResource Paper}" Foreground="{StaticResource Ink}"
        FontFamily="{StaticResource Body}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <DockPanel>

    <!-- ============ red header ============ -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Red}" Padding="32,24,32,26">
      <DockPanel>
        <ToggleButton x:Name="VoiceToggle" DockPanel.Dock="Right" VerticalAlignment="Center"
                      Style="{StaticResource HeaderToggle}" Content="Voice off" Click="VoiceToggle_Click"/>
        <StackPanel VerticalAlignment="Center" Margin="0,0,24,0">
          <TextBlock FontFamily="{StaticResource Display}" FontSize="38" FontWeight="Black" Foreground="White">
            <Run Text="CashVoice"/><Run Text="." Foreground="{StaticResource Ink}"/>
          </TextBlock>
          <TextBlock x:Name="StatusText" Foreground="#E6FFFFFF" Margin="2,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs">

      <!-- ============ VOICE ============ -->
      <TabItem Header="Voice">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0" Margin="0,0,36,0">
            <TextBlock DockPanel.Dock="Top" Text="VOICES" Style="{StaticResource Eyebrow}"/>
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
              <Button Content="+ New" Style="{StaticResource Quiet}" Margin="0,0,6,6" Click="AddVoice_Click"/>
              <Button Content="Delete" Style="{StaticResource Quiet}" Margin="0,0,6,6" Click="DeleteVoice_Click"/>
              <Button Content="Reset" Style="{StaticResource Quiet}" Margin="0,0,6,6" Click="ResetVoices_Click"/>
            </WrapPanel>
            <ListBox x:Name="VoiceList" SelectionChanged="VoiceList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource KeyTag}" x:Name="tag">
                      <TextBlock Text="{Binding Hotkey}" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  </DockPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Hotkey}" Value="">
                      <Setter TargetName="tag" Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel x:Name="VoiceEditor"/>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ============ SOUNDBOARD ============ -->
      <TabItem Header="Soundboard">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="ADD A SOUND" Style="{StaticResource Eyebrow}"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Import file" Margin="8,0,0,0" Click="ImportFile_Click"/>
              <Button x:Name="DownloadBtn" DockPanel.Dock="Right" Content="Download" Style="{StaticResource Primary}"
                      Margin="8,0,0,0" Click="Download_Click"/>
              <TextBox x:Name="UrlBox" ToolTip="Paste a YouTube link here, then press Download"/>
            </DockPanel>
            <TextBlock x:Name="ImportStatus" Style="{StaticResource Muted}" Margin="2,8,0,0"
                       Text="Paste a YouTube link, import a file, or drag audio onto this window."/>
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="270"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Text="SOUNDS" Style="{StaticResource Eyebrow}"/>
              <ListBox x:Name="SoundList" SelectionChanged="SoundList_SelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <Button DockPanel.Dock="Left" Style="{StaticResource Play}" Margin="0,0,14,0"
                              ToolTip="Play" Click="PlaySound_Click"/>
                      <Border DockPanel.Dock="Right" Style="{StaticResource KeyTag}" x:Name="tag">
                        <TextBlock Text="{Binding Hotkey}" FontSize="11" FontWeight="SemiBold"/>
                      </Border>
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="15" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Hotkey}" Value="">
                        <Setter TargetName="tag" Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <StackPanel x:Name="SoundDetails" Grid.Column="1" Margin="36,0,0,0" IsEnabled="False">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="NAME" Style="{StaticResource Eyebrow}"/>
              <TextBox x:Name="SoundName" Margin="0,0,0,20" LostFocus="SoundName_LostFocus"/>
              <TextBlock Text="VOLUME" Style="{StaticResource Eyebrow}"/>
              <Slider x:Name="SoundVolume" Minimum="0" Maximum="1.5" Value="1" Margin="0,0,0,20" ValueChanged="SoundVolume_Changed"/>
              <TextBlock Text="HOTKEY" Style="{StaticResource Eyebrow}"/>
              <c:HotkeyBox x:Name="SoundHotkey" Margin="0,0,0,24"/>
              <Button Content="Delete sound" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Click="DeleteSound_Click"/>
            </StackPanel>
          </Grid>
        </Grid>
      </TabItem>

      <!-- ============ SETTINGS ============ -->
      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="720" HorizontalAlignment="Left" Margin="0,0,16,8">

            <TextBlock Text="MICROPHONE" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Which mics get the effect" Style="{StaticResource H2}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                       Text="Tick the mic you talk into and press Apply. Windows asks for admin and restarts audio for a second. Apps then use that mic like normal."/>
            <StackPanel x:Name="MicList" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Apply" Style="{StaticResource Primary}" Padding="26,0" Click="ApplyMics_Click"/>
              <Button Content="Refresh list" Style="{StaticResource Quiet}" Margin="10,0,0,0" Click="RefreshMics_Click"/>
            </StackPanel>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,30"/>
            <TextBlock Text="AUDIO" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Levels" Style="{StaticResource H2}" Margin="0,0,0,10"/>
            <CheckBox x:Name="ChkSoundsIntoMic" Content="Play soundboard sounds into the mic" Click="Settings_Changed"/>
            <CheckBox x:Name="ChkMonitor" Content="Also play them on my speakers / headphones" Click="Settings_Changed"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Mic volume" VerticalAlignment="Center"/>
              <Slider x:Name="SldMic" Grid.Column="1" Minimum="0" Maximum="2" ValueChanged="Settings_Slider"/>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Soundboard volume (in mic)" VerticalAlignment="Center"/>
              <Slider x:Name="SldSound" Grid.Column="1" Minimum="0" Maximum="2" ValueChanged="Settings_Slider"/>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="Soundboard volume (speakers)" VerticalAlignment="Center"/>
              <Slider x:Name="SldLocal" Grid.Column="1" Minimum="0" Maximum="1" ValueChanged="Settings_Slider"/>
            </Grid>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,30"/>
            <TextBlock Text="HOTKEYS" Style="{StaticResource Eyebrow}"/>
            <TextBlock Text="Global shortcuts" Style="{StaticResource H2}" Margin="0,0,0,10"/>
            <StackPanel x:Name="GlobalHotkeys"/>
            <TextBlock x:Name="HotkeyStatus" Foreground="{StaticResource Red}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                       Text="Each voice and each sound can have its own hotkey too."/>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,30"/>
            <TextBlock Text="GENERAL" Style="{StaticResource Eyebrow}"/>
            <CheckBox x:Name="ChkAutostart" Content="Start with Windows (minimised to tray)" Click="Settings_Changed"/>
            <Button Content="Update yt-dlp" Style="{StaticResource Quiet}" Margin="0,14,0,0" HorizontalAlignment="Left" Click="UpdateYtDlp_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
